# ==========================================
# UNFINIT Store Engine - .gitignore
# ==========================================

# 1. Environment & Sensitive Credentials
.env
.env.*
!.env.example
!env.example
*.pem
*.key
*.cert

# 2. Platform Sessions & Encrypted Credentials (Zero-Git Exposure)
*.session
*.session.enc
*.session-journal
*.rubpy
*.rp
*.enc
data/*.session
data/*.session.enc
data/*.enc
data/sessions/
soroush.session*
rubika.session*
unfinit_instagram.json
unfinit_session_cache.json
sessions/

# 3. Databases & SQLite Storage
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
store_database.db
data/
*.enc
users.json
data/users.json.enc

# 4. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Build
build/
dist/
*.egg-info/
.eggs/

# 5. Temporary Folders, Downloads & Logs
temp_downloads/
downloads/
queue/
*.log
logs/
*.tmp
*.temp

# 6. IDEs & OS Specific Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
