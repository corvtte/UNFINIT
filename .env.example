# =================================================================
# موتور جامع فروشگاه و استودیوی چندرسانه‌ای UNFINIT Store Engine
# فایل راهنمای تنظیم متغیرهای محیطی (Environment Variables Guide)
# نگارش v25.7.5
# =================================================================
# نکته امنیتی: در محیط‌های ابری نظیر هاگینگ‌فیس (Hugging Face Spaces) یا داکر،
# نیازی به ساخت فایل .env نیست و این متغیرها مستقیماً در بخش Secrets / Environment Variables
# پلتفرم تعریف می‌شوند. موتور به طور خودکار اولویت قطعی را به متغیرهای محیطی می‌دهد.
# =================================================================

# -----------------------------------------------------------------
# ۱. تنظیمات پیام‌رسان تلگرام (Telegram Bot & Client MTProto)
# -----------------------------------------------------------------
# شناسه API کاربری تلگرام (دریافتی از https://my.telegram.org)
API_ID=0
# هش اختصاصی API تلگرام (دریافتی از https://my.telegram.org)
API_HASH=your_telegram_api_hash_here
# توکن ربات تلگرام (دریافتی از @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# آیدی عددی چت ادمین/مالک اصلی ربات در تلگرام جهت دریافت گزارش‌ها
TELEGRAM_OWNER_ID=0
# شناسه عددی سوپرگروه تاپیک‌دار تلگرام جهت ساخت و تفکیک خودکار تاپیک‌های فیش، لاگ، مدیا و تیکت‌ها
TELEGRAM_FORUM_GROUP_ID=

# -----------------------------------------------------------------
# ۲. تنظیمات پیام‌رسان بله (Bale Messenger Bot API & Payment)
# -----------------------------------------------------------------
# توکن ربات بله (دریافتی از @BotFather در پیام‌رسان بله)
BALE_BOT_TOKEN=your_bale_bot_token_here
# شناسه عددی چت ادمین در بله جهت دریافت اعلان‌های کارت‌به‌کارت و فیش‌های واریزی
BALE_OWNER_ID=402479514
# توکن درگاه پرداخت مستقیم بله (ارائه‌شده توسط بانک ملی / بله)
BALE_PAYMENT_TOKEN=

# -----------------------------------------------------------------
# ۳. تنظیمات پیام‌رسان روبیکا (Rubika Bot & User Session)
# -----------------------------------------------------------------
# توکن ربات رسمی روبیکا (دریافتی از BotFather در روبیکا)
RUBIKA_BOT_TOKEN=
# آیدی یا نام کاربری مقصد در روبیکا
RUBIKA_OWNER_ID=
# نام فایل نشست کاربری روبیکا برای آپلودهای حجیم ۲ گیگابایتی (بدون پسوند)
RUBIKA_SESSION=unfinit_rubika

# -----------------------------------------------------------------
# ۴. تنظیمات حساب اینستاگرام (Instagram Private API)
# -----------------------------------------------------------------
# نام کاربری اینستاگرام
INSTAGRAM_USERNAME=
# کلمه عبور حساب اینستاگرام
INSTAGRAM_PASSWORD=
# مسیر فایل ذخیره نشست ورود اینستاگرام
INSTAGRAM_SESSION_FILE=unfinit_instagram.json

# -----------------------------------------------------------------
# ۵. تنظیمات فروشگاه، پرداخت و قوانین (Storefront & Online Payment)
# -----------------------------------------------------------------
# عنوان نمایشی فروشگاه
STORE_NAME=فروشگاه دوره‌های آموزشی UNFINIT
# متن خوش‌آمدگویی صفحه اصلی فروشگاه و ربات‌ها
WELCOME_TEXT=به فروشگاه دوره‌های آموزشی و دانلودی UNFINIT خوش آمدید.
# قوانین و مقررات خرید
TERMS_TEXT=کلیه حقوق مادی و معنوی دوره‌ها متعلق به این مجموعه می‌باشد.
# شماره کارت بانکی جهت دریافت واریزی کارت‌به‌کارت خریداران
CARD_NUMBER=6037991122334455
# نام و نام خانوادگی دارنده شماره کارت بانکی
CARD_HOLDER=نام صاحب حساب
# کد مرچنت ۳۶ کاراکتری درگاه پرداخت زرین‌پال (Zarinpal Merchant ID)
ZARINPAL_MERCHANT_ID=
# وضعیت محیط تست زرین‌پال (0 = درگاه واقعی شتاب، 1 = سندباکس تستی)
ZARINPAL_SANDBOX=0
# درصد کش‌بک و پاداش خرید به کیف پول کاربر (پیش‌فرض: 10)
CASHBACK_PERCENT=10
# سقف کاراکتر توضیحات دوره‌ها جهت سازگاری با فاکتورهای بانکی (پیش‌فرض: 255)
COURSE_DESC_MAX_LEN=255

# -----------------------------------------------------------------
# ۶. استانداردهای رسانه‌ای و برش (Media Studio Defaults)
# -----------------------------------------------------------------
# نام خواننده / مدرس پیش‌فرض برای تگ‌های ID3 و متادیتای صوتی
DEFAULT_ARTIST=AbbasManesh365 Bot
# نام آلبوم پیش‌فرض فایل‌های صوتی
DEFAULT_ALBUM=دوره آموزشی
# حداکثر حجم امن ارسال مستقیم در پیام‌رسان بله به مگابایت (پیش‌فرض: 49.99)
MAX_SAFE_BALE_SIZE_MB=49.99

# -----------------------------------------------------------------
# ۷. قفل عضویت اجباری کانال‌ها (Force Join Channels)
# -----------------------------------------------------------------
# آیدی یا یوزرنیم کانال تلگرام برای عضویت اجباری (مثال: @mychannel یا -100123456789)
FORCE_JOIN_CHANNEL_TELEGRAM=
# آیدی یا یوزرنیم کانال بله برای عضویت اجباری
FORCE_JOIN_CHANNEL_BALE=

# -----------------------------------------------------------------
# ۸. سرور، پورت و ذخیره‌سازی داده‌های پایدار (Storage & Hosting)
# -----------------------------------------------------------------
# پورت اجرای وب‌سرور (پیش‌فرض هاگینگ‌فیس: 7860)
PORT=7860
# مسیر هارد پایدار Persistent Volume در هاگینگ‌فیس (پیش‌فرض: /data)
PERSISTENT_DATA_DIR=/data
# دایرکتوری موقت دانلودها و پردازش فایل‌های رسانه‌ای
TEMP_DIR=

# -----------------------------------------------------------------
# ۹. امنیت، ادمین‌های مجاز و احراز هویت (Admin Security & Multi-Admin)
# -----------------------------------------------------------------
# رمز عبور ورود به پنل تحت وب ادمین (حتماً در Hugging Face Secrets یا اینجا تنظیم فرمایید)
ADMIN_PANEL_PASSWORD=your_strong_secret_password_here
# لیست شناسه‌های عددی ادمین‌های مجاز در تلگرام و بله به صورت جدا شده با کاما (مثال: 123456,7891011)
ADMIN_USER_IDS=

# -----------------------------------------------------------------
# ۱۰. سرویس هوش مصنوعی روتر نارا (Hermes AI / Nara Router)
# -----------------------------------------------------------------
# کلید API روتر نارا
NARA_API_KEY=
# مدل هوش مصنوعی انتخابی نارا (پیش‌فرض رایگان: mimo-v2.5-free)
NARA_MODEL=mimo-v2.5-free
# نشانی پایه API روتر نارا
NARA_BASE_URL=https://router.bynara.id/v1

# -----------------------------------------------------------------
# ۱۱. سرویس هوش مصنوعی گوگل جمینای (Google Gemini Audio & Captions)
# -----------------------------------------------------------------
# کلید API اختصاصی گوگل جمینای
GEMINI_API_KEY=
# مدل جمینای جهت رونوشت صوت و ساخت کپشن (gemini-3.6-flash یا gemini-3.8-flash یا gemini-3.1-pro)
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------
# ۱۲. نگارش موتور (Engine Version)
# -----------------------------------------------------------------
ENGINE_VERSION=v25.7.5
# Supported versions for backward-compatibility: ENGINE_VERSION=v25.7.4
